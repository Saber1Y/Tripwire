# RPC endpoints (public defaults; swap in a private RPC if you hit rate limits)
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
LASNA_RPC=https://lasna-rpc.rnk.dev/

# Name of the encrypted Foundry keystore holding the deployer key (created with `cast wallet import`).
# The private key itself never goes in this file.
DEPLOYER_ACCOUNT=tripwire-deployer

# Optional overrides (wei)
# SPIKE_REACTIVE_FUNDING=2000000000000000000
# SPIKE_CALLBACK_FUNDING=10000000000000000
